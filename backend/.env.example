PORT=3001

# Optional: comma-separated extra allowed frontend origins
# Example: https://atlas.pages.dev,https://other-site.pages.dev
FRONTEND_ORIGINS=

# Vite también lee este archivo para las operaciones multimedia locales.

# Solo servidor: autorización de operaciones multimedia. Nunca usar VITE_ para la clave.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Solo servidor: acceso S3 a R2 (Worker/Functions usan el binding R2_BUCKET).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=atlas-media
R2_PUBLIC_DOMAIN=
