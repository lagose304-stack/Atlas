VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local: http://localhost:3001
# Produccion: URL publica de tu backend (sin slash final)
# Dejar vacío si usarás Cloudflare Functions en producción.
VITE_BACKEND_BASE_URL=

# Solo servidor: autorización de operaciones multimedia. Nunca usar VITE_ para la clave.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Solo servidor: acceso S3 a R2 (Worker/Functions usan el binding R2_BUCKET).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=atlas-media
R2_PUBLIC_DOMAIN=

# Opcional en el frontend; dejar vacío para usar el dominio predeterminado del proyecto.
VITE_R2_PUBLIC_DOMAIN=
